{
  "name": "barbershop-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:all": "node scripts/dev-all.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "node scripts/test-database.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "demo:users": "node --env-file=.env.local scripts/seed-users.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:bookings": "node scripts/seed-bookings.mjs",
    "demo:history": "node scripts/seed-customer-history.mjs",
    "demo:segments": "node scripts/seed-segments.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}
